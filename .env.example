# ─── SECURITY ────────────────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-64-output
ENCRYPTION_KEY=change-me-32-bytes-for-aes256

# ─── ANTHROPIC (for AI document analysis + RAG) ──────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPENAI (for embeddings: text-embedding-3-small) ─────────
OPENAI_API_KEY=sk-...

# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://docuflow:secret@postgres:5432/docuflow
POSTGRES_PASSWORD=secret

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── KAFKA ───────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ─── OBJECT STORAGE (S3 or MinIO for local dev) ──────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docuflow
S3_ACCESS_KEY=docuflow
S3_SECRET_KEY=secret123
# For production AWS S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ─── VECTOR DATABASE ─────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── OAUTH2 PROVIDERS ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── INTEGRATION SECRETS ─────────────────────────────────────
SLACK_SIGNING_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ─── APP ─────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
